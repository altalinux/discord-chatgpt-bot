DISCORD_TOKEN=your_discord_bot_token
OPENAI_API_KEY=your_openai_api_key

# Optional
OPENAI_MODEL=gpt-5.2
BOT_SYSTEM_PROMPT=You are a helpful assistant chatting in Discord. Keep replies friendly and concise.
# Comma-separated Discord channel IDs. Leave empty to allow all channels.
ALLOWED_CHANNEL_IDS=
# Conversation history timeout in minutes.
CONVERSATION_TIMEOUT_MINUTES=60
# Enable web search for messages that look like they need current information.
WEB_SEARCH_ENABLED=true
