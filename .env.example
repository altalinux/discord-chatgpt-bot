DISCORD_TOKEN=your_discord_bot_token
AI_PROVIDER=openai

# OpenAI (required when AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-terra
# Reasoning effort: none, low, medium, high, xhigh, or max.
OPENAI_REASONING_EFFORT=medium

# Gemini (required when AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
# Thinking level: minimal, low, medium, or high. Leave empty to use the model default.
GEMINI_THINKING_LEVEL=medium
# Enable only when Google Search grounding is available for the selected model and billing tier.
GEMINI_GOOGLE_SEARCH_ENABLED=false

# Sarashina (required when AI_PROVIDER=sarashina)
SARASHINA_API_KEY=your_sarashina_api_key
SARASHINA_MODEL=sarashina3-mini

# Shared options
BOT_SYSTEM_PROMPT=You are a helpful assistant chatting in Discord. Keep replies friendly and concise.
# Comma-separated Discord channel IDs. Leave empty to allow all channels.
ALLOWED_CHANNEL_IDS=
# Shared channel conversation history timeout in minutes.
CONVERSATION_TIMEOUT_MINUTES=60
# Enable web search for messages that look like they need current information.
WEB_SEARCH_ENABLED=true
